{
  "name": "vibe-coding-mcp",
  "version": "2.15.2",
  "mcpName": "io.github.MUSE-CODE-SPACE/vibe-coding",
  "description": "Auto-capture Claude Code sessions from their transcripts (hook + CLI), then summarize, digest, document, and publish them — MCP server + agent skill",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "vibe-coding-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "skills/**"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns='integration'",
    "test:tools": "node scripts/test-tools.mjs",
    "skill:pack": "node scripts/pack-skill.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "mcp",
    "vibe-coding",
    "documentation",
    "notion",
    "obsidian",
    "github-wiki",
    "claude",
    "claude-code",
    "claude-code-hooks",
    "agent-skills",
    "skill",
    "ai-coding",
    "model-context-protocol",
    "git"
  ],
  "author": "MUSE-CODE-SPACE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MUSE-CODE-SPACE/vibe-coding-mcp.git"
  },
  "homepage": "https://github.com/MUSE-CODE-SPACE/vibe-coding-mcp#readme",
  "bugs": {
    "url": "https://github.com/MUSE-CODE-SPACE/vibe-coding-mcp/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@notionhq/client": "^5.27.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
