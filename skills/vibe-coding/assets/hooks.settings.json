{
  "mcpServers": {
    "vibe-coding-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "vibe-coding-mcp"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y vibe-coding-mcp hook",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y vibe-coding-mcp hook",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y vibe-coding-mcp hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
