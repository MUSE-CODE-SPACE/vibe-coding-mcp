# Notion API
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_database_id_here

# GitHub (for Wiki)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo

# Obsidian
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# HTTP server (npm start) — only needed when you run the Streamable HTTP transport
# HOST=127.0.0.1                 # default; set 0.0.0.0 to expose it (and set MCP_AUTH_TOKEN)
# PORT=3000
# MCP_AUTH_TOKEN=change-me       # /mcp then requires "Authorization: Bearer <token>"
# MCP_ALLOWED_ORIGINS=https://app.example.com

# SessionStart project-memory brief
# VIBE_CODING_RECALL=off
# VIBE_CODING_RECALL_SESSIONS=3
# VIBE_CODING_RECALL_CHARS=2000
# VIBE_CODING_RECALL_LANG=ko
